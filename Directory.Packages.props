<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Single source of package versions in the repo. Each .csproj does
    <PackageReference Include="..." /> with no Version attribute.

    All versions below were verified against nuget.org on 2026-09-10 (T03),
    not assumed. Details and reasoning in README.md.
  -->

  <!--
    MassTransit pinned to 8.5.8, NOT 9.x. v9+ went commercial (see
    massient.com/license); 8.5.8 is the last Apache-2.0 release, with
    security support announced through end of 2026. Revisit before then.
  -->
  <ItemGroup>
    <PackageVersion Include="MassTransit" Version="8.5.8" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.8" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.5.8" />
  </ItemGroup>

  <!-- EF Core 10 + PostgreSQL provider -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- Testcontainers -->
  <ItemGroup>
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.15.0" />
  </ItemGroup>

  <!-- OpenTelemetry -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
  </ItemGroup>

  <!--
    Test libraries (see ESTANDAR-CALIDAD.md section 7). Verify.Xunit and
    NetArchTest.Rules are deliberately not used: the former is deprecated
    by its own maintainer (replaced by Verify.XunitV3), the latter hasn't
    shipped since 2021. Their actively maintained replacements require
    xUnit v3 instead of v2 (see the xunit.v3 ItemGroup below).
  -->
  <ItemGroup>
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Verify.XunitV3" Version="32.0.0" />
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.4" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.4" />
  </ItemGroup>

  <!--
    xUnit v3 + Microsoft.Testing.Platform. Replaces xunit 2.9.3 /
    xunit.runner.visualstudio (the SDK's default template), migrated in T03
    to use Verify.XunitV3 and TngTech.ArchUnitNET.xUnitV3.
  -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.0" />
  </ItemGroup>

</Project>
