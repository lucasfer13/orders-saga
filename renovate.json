{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Madrid",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "NuGet minor/patch: grouped into one weekly PR, low risk.",
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "nuget minor/patch",
      "automerge": false
    },
    {
      "description": "NuGet major: separate PR per package, never grouped. Can bring behavior changes (see ESTANDAR-CALIDAD.md, license/breaking-change notes).",
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "GitHub Actions: grouped, low risk, noisy one-by-one.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Docker base images: separate PR, can affect the Trivy/docker scout attack surface.",
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": null,
      "labels": ["dependencies", "docker"]
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  }
}
