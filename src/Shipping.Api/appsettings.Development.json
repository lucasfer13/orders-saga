{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Not a stored secret: it is an overridable default. Configuration precedence is
  // appsettings.json -> appsettings.{Environment}.json -> user secrets -> environment
  // variables -> command line, so the ConnectionStrings__Database that docker compose
  // sets always wins. These are the same local-only credentials already published in
  // docker-compose.yml and in the README, and versioning them is what lets anyone
  // clone the repo and press F5 without recreating an undocumented file by hand.
  //
  // Timeout is 3s, not the 15s default: a ready probe must not outlive its own
  // health check timeout.
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=shipping;Username=orders_saga;Password=orders_saga_dev_only;Timeout=3"
  }
}
